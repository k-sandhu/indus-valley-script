{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarantined Helsinki 1979 v3 physical-line proposal",
  "type": "object",
  "required": ["inventory_version", "edition", "occurrence_key", "segment_id", "pdf_page", "pdf_column", "row_index", "glyph_pdf_box", "margin_pdf_box", "line_kind", "text_occurrence_key", "continuation_of", "inscription_number", "classification_code", "units", "auxiliaries", "boundary_blanks", "flags", "quarantined", "released", "review_status", "pipeline_freeze_sha256", "source_sha256"],
  "properties": {
    "inventory_version": {"const": "helsinki1979-crop-v3-2026-10-08"},
    "edition": {"const": "Koskenniemi-Parpola-1979"},
    "occurrence_key": {"type": "string", "pattern": "^helsinki1979-v3:pdf[0-9]+:c[0-9]+:r[0-9]+$"},
    "segment_id": {"type": "string", "minLength": 1},
    "pdf_page": {"type": "integer", "minimum": 22, "maximum": 180},
    "pdf_column": {"type": "integer", "minimum": 0},
    "row_index": {"type": "integer", "minimum": 0},
    "glyph_pdf_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "margin_pdf_box": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}]},
    "line_kind": {"enum": ["numbered", "continuation"]},
    "text_occurrence_key": {"type": "string", "minLength": 1},
    "continuation_of": {"type": ["string", "null"]},
    "inscription_number": {"type": ["string", "null"]},
    "classification_code": {"type": ["string", "null"]},
    "units": {"type": "array", "items": {"type": "object", "required": ["unit_pdf_box", "alternatives", "confidence", "confidence_status"], "properties": {
      "unit_pdf_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
      "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
      "confidence_status": {"const": "unchanged_development_logistic_not_recalibrated"},
      "alternatives": {"type": "array", "maxItems": 5, "items": {"type": "object", "required": ["codes", "ranks", "combined_cost"], "properties": {"codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}}, "ranks": {"type": "array", "items": {"type": "integer"}}, "combined_cost": {"type": "number"}}}}
    }}},
    "auxiliaries": {"type": "array"},
    "boundary_blanks": {"type": "array"},
    "flags": {"type": "array", "items": {"type": "string"}},
    "quarantined": {"const": true},
    "released": {"const": false},
    "review_status": {"const": "unreviewed"},
    "pipeline_freeze_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
