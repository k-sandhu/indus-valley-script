{% extends "base.jinja" %}
{% block content %}
<dl class="metadata">
{% for key in ['status_class', 'status', 'area', 'credence', 'risk', 'kind', 'difficulty', 'data_access', 'priority', 'claimed_by', 'claim_expires'] %}
{% if fields.get(key) is not none and fields.get(key) != '' %}<div><dt>{{ key|label }}</dt><dd>{% if key in ['status', 'status_class'] %}<span class="badge {{ fields[key] }}">{{ fields[key]|label }}</span>{% else %}{{ fields[key] }}{% endif %}</dd></div>{% endif %}
{% endfor %}
</dl>
{% if claim_url %}<p><a class="action" href="{{ claim_url }}">Claim or discuss on GitHub</a></p>{% endif %}
{% if history %}
<h2>Credence history</h2>
<div class="table-wrap"><table><thead><tr><th scope="col">Date</th><th scope="col">Credence</th><th scope="col">Reason</th></tr></thead><tbody>
{% for row in history %}<tr><td>{{ row.date }}</td><td>{{ row.value }}</td><td>{{ row.reason }}</td></tr>{% endfor %}
</tbody></table></div>
{% endif %}
{{ body|safe }}
{% endblock %}
