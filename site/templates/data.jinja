{% extends "base.jinja" %}
{% block content %}
{% if toc %}
<nav class="toc-box" aria-label="On this page">
  <p class="toc-title">On this page</p>
  <ul>{% for entry in toc %}<li><a href="#{{ entry.id }}">{{ entry.label }}</a></li>{% endfor %}</ul>
</nav>
{% endif %}
<div class="prose-body">
{{ body|safe }}
</div>
{% if rows %}
<h2>Source manifest</h2>
<p>Tracked metadata summary of acquired and local-only inputs from <code>data/MANIFEST.json</code>.</p>
<div class="table-wrap"><table><thead><tr><th scope="col">ID</th><th scope="col">Source</th><th scope="col">Status</th><th scope="col">Location</th><th scope="col">Rights</th><th scope="col">Size</th></tr></thead><tbody>{% for row in rows %}<tr><td><code>{{ row.id }}</code></td><td>{{ row.title }}</td><td><span class="badge {{ row.status }}">{{ row.status|label }}</span></td><td>{{ row.location }}</td><td>{{ row.rights.status }}{% if row.rights.licence %}: {{ row.rights.licence }}{% endif %}</td><td>{{ row.size }}</td></tr>{% endfor %}</tbody></table></div>
{% endif %}
{% endblock %}
