{% extends "base.jinja" %}
{% block content %}
{{ purpose|safe }}
<dl class="counts">{% for label, count in counts.items() %}<div><dt>{{ label }}</dt><dd>{{ count }}</dd></div>{% endfor %}</dl>
<p><a href="findings/index.html">Browse findings by theme</a> · <a href="#recent-work">Recent work</a></p>
<h2>Where things stand</h2>
{{ standing|safe }}
<h2 id="recent-work">Recent work</h2>
<p>The ten most recent research attempts, dated by their records or research packages. Coordination and preservation records are listed in the registry. <a href="attempts/index.html">Browse the registry</a> or read the <a href="timeline/index.html">timeline</a>.</p>
<ol class="recent-work">
{% for row in recent %}<li>
  <div class="record-meta">{% if row.date %}<time datetime="{{ row.date }}">{{ row.date }}</time>{% else %}<span>Undated</span>{% endif %} <span class="badge {{ row.status }}">{{ row.status|label }}</span></div>
  {% if row.report_url %}<a href="{{ row.report_url }}">{{ row.theme or row.title }}</a>{% else %}<span class="unavailable">{{ row.theme or row.title }} (not in the public repository)</span>{% endif %}
  <small>{{ row.id }}</small>
</li>{% endfor %}
</ol>
<h2>Working model</h2>
{% for headline in headlines %}<section><h3>{{ headline.heading }}</h3>{{ headline.body|safe }}</section>{% endfor %}
<p><a href="working-model/index.html">Working model</a></p>
<h2>Conjectures</h2>
<div class="table-wrap"><table><thead><tr><th scope="col">ID</th><th scope="col">Claim</th><th scope="col">Status</th><th scope="col">Credence</th></tr></thead><tbody>{% for row in conjectures %}<tr><td><a href="conjectures/{{ row.url }}">{{ row.id }}</a></td><td>{{ row.title }}</td><td><span class="badge {{ row.status }}">{{ row.status|label }}</span></td><td>{{ row.credence }}</td></tr>{% endfor %}</tbody></table></div>
<p><a href="contribute/index.html">Contribute</a> · <a href="data.html">Data</a></p>
<p class="bootstrap">{{ bootstrap }}</p>
{% endblock %}
