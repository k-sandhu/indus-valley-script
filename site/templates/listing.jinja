{% extends "base.jinja" %}
{% block content %}
{% if kind == 'finding' and findings %}
<div class="prose-intro">{{ findings.intro|safe }}</div>
<nav class="theme-nav" aria-label="Finding themes">
  <ul>
    {% for theme in findings.themes %}<li><a href="#{{ theme.anchor }}"><span>{{ theme.title }}</span> <small>{{ theme.rows|length }}</small></a></li>{% endfor %}
    {% if findings.uncarded %}<li><a href="#not-yet-carded"><span>Not yet carded</span></a></li>{% endif %}
  </ul>
</nav>
{% elif kind == 'question' %}
<p class="lead">Open research, metadata, verification and data-acquisition tasks. Filter by data access or difficulty to find a task you or an AI agent can run, check existing GitHub issues for active claims, and claim it on GitHub.</p>
<p class="inline-links"><a href="../agents/index.html">Agent coordination hub</a> · <a href="../contribute/index.html">How claims and PRs work</a> · <a href="index.json">JSON queue</a></p>
{% elif kind == 'conjecture' %}
<p class="lead">Each conjecture states a working claim with a numeric credence (0 to 1), testable predictions and a kill condition. Dead and weakened claims remain visible alongside active ones. <a href="rules.html">Read conjecture rules</a> or the <a href="../working-model/index.html">working model</a>.</p>
{% elif kind == 'attempt' %}
<p class="lead">Every recorded research run ordered newest first, including exploratory, failed and superseded attempts. Read the <a href="../timeline/index.html">timeline</a> for the narrative overview.</p>
<nav class="date-nav" aria-label="Registry dates"><ul>{% for group in attempt_groups %}<li><a href="#date-{{ group.date or 'undated' }}">{{ group.title }}</a></li>{% endfor %}</ul></nav>
{% endif %}

<div class="listing" data-index="{{ index_url }}" data-kind="{{ kind }}">
{% if kind == 'question' %}
  <div class="quick-chips js-only" role="group" aria-label="Quick filters" hidden>
    <button type="button" class="chip active" aria-pressed="true" data-preset="all">All open ({{ rows|length }})</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"data_access":"public"}'>Public data</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"data_access":"none-needed"}'>No external data</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"difficulty":"starter"}'>Starter friendly</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"priority":"1"}'>Priority 1</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"kind":"data-acquisition"}'>Data acquisition</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"kind":"verification"}'>Verification</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"status":"open"}'>No merged claim</button>
  </div>
{% elif kind == 'finding' %}
  <div class="quick-chips js-only" role="group" aria-label="Quick filters" hidden>
    <button type="button" class="chip active" aria-pressed="true" data-preset="all">All findings ({{ rows|length }})</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"status":"frozen-evaluation"}'>Frozen evaluations</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"status":"verified-computation"}'>Verified computations</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"status":"source-review"}'>Source reviews</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"status":"failed"}'>Failed tests</button>
  </div>
{% elif kind == 'conjecture' %}
  <div class="quick-chips js-only" role="group" aria-label="Quick filters" hidden>
    <button type="button" class="chip active" aria-pressed="true" data-preset="all">All ({{ rows|length }})</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"status":"open"}'>Open</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"status":"strengthened"}'>Strengthened</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"risk":"long-shot"}'>Long shots</button>
    <button type="button" class="chip" aria-pressed="false" data-preset='{"status":"dead"}'>Dead / falsified</button>
  </div>
{% endif %}

<form class="filters" role="search">
  <label class="search-grow">Search <input type="search" name="search" autocomplete="off" placeholder="Filter by keyword, ID, or site…"></label>
  {% for field, values in filters.items() %}<label>{{ field|label }} <select name="{{ field }}"><option value="">All</option>{% for value in values %}<option value="{{ value }}">{{ value|label }}</option>{% endfor %}</select></label>{% endfor %}
  <button type="reset">Reset</button>
</form>

<p class="filter-count" role="status" aria-live="polite">{{ rows|length }} {{ 'questions' if kind == 'question' else 'attempts' if kind == 'attempt' else 'conjectures' if kind == 'conjecture' else 'cards' }}</p>

{% if kind == 'finding' %}
{% if findings %}
{% for theme in findings.themes %}
<section class="finding-theme" data-group aria-labelledby="{{ theme.anchor }}">
  <h2 id="{{ theme.anchor }}">{{ theme.title }}</h2>
  <div class="theme-prose">{{ theme.intro|safe }}</div>
  <ul class="cards">{% for row in theme.rows %}<li class="card-row" data-id="{{ row.id }}">
    <div class="card-row-head">
      <h3><a href="{{ row.href }}">{{ row.id }}: {{ row.title }}</a></h3>
      <span class="badge {{ row.status }}">{{ row.status|label }}</span>
    </div>
    {% if row.result_html %}{{ row.result_html|safe }}{% else %}<p>{{ row.claim }}</p>{% endif %}
  </li>{% endfor %}</ul>
</section>
{% endfor %}
{% else %}
{% for area, group in rows|groupby('area') %}<section data-group><h2>{{ area|capitalize }}</h2><ul class="cards">{% for row in group %}<li data-id="{{ row.id }}"><a href="{{ row.href }}">{{ row.id }}: {{ row.title }}</a> <span class="badge {{ row.status }}">{{ row.status|label }}</span></li>{% endfor %}</ul></section>{% endfor %}
{% endif %}

{% elif kind == 'question' %}
<div class="question-board">
{% for row in rows %}<article class="question" data-id="{{ row.id }}">
  <div class="q-top">
    <span class="qid-pill">{{ row.id }}</span>
    <span class="badge {{ row.status }}">{{ row.status|label }}</span>
    <span class="priority-pill p-{{ row.priority }}">P{{ row.priority }}</span>
    <span class="meta-tag">{{ row.area }}</span>
  </div>
  <h2><a href="{{ row.href }}">{{ row.title }}</a></h2>
  <p>{{ row.claim }}</p>
  <dl class="q-meta">
    <div><dt>Task kind</dt><dd>{{ row.kind|label }}</dd></div>
    <div><dt>Data access</dt><dd>{{ row.data_access|label }}</dd></div>
    <div><dt>Difficulty</dt><dd>{{ row.difficulty }}</dd></div>
    <div><dt>Merged claim</dt><dd>{{ row.claimed_by or 'No merged claim; check the issue' }}</dd></div>
  </dl>
  <div class="q-actions">
    <a class="btn-small btn-primary-sm" href="{{ row.href }}">Read brief and prompt</a>
    {% if row.issues_url %}<a class="btn-small btn-outline-sm" href="{{ row.issues_url }}">Check issues</a>{% endif %}
    {% if row.claim_url %}<a class="btn-small btn-outline-sm" href="{{ row.claim_url }}">Claim on GitHub</a>{% endif %}
  </div>
</article>{% endfor %}
</div>

{% elif kind == 'attempt' %}
{% for group in attempt_groups %}<section class="attempt-group" data-group aria-labelledby="date-{{ group.date or 'undated' }}"><h2 id="date-{{ group.date or 'undated' }}">{{ group.title }}</h2>
<div class="table-wrap"><table><thead><tr><th scope="col">Date</th><th scope="col">Attempt</th><th scope="col">Area</th><th scope="col">Status</th><th scope="col">Outcome</th></tr></thead><tbody>
{% for row in group.rows %}<tr data-id="{{ row.id }}"><td class="nowrap">{% if row.date %}<time datetime="{{ row.date }}">{{ row.date }}</time>{% else %}Undated{% endif %}</td><td><a href="{{ row.href }}">{{ row.id }}</a><p>{{ row.theme or row.title }}</p><p class="muted-small">{{ row.question }}</p></td><td>{{ row.area }}</td><td><span class="badge {{ row.status }}">{{ row.status|label }}</span></td><td>{{ row.outcome }}</td></tr>{% endfor %}
</tbody></table></div></section>{% endfor %}

{% else %}
<div class="table-wrap"><table><thead><tr><th scope="col">ID</th><th scope="col">Claim</th><th scope="col">Area</th><th scope="col">Status</th><th scope="col">Credence</th><th scope="col">Risk</th></tr></thead><tbody>
{% for row in rows %}<tr data-id="{{ row.id }}">
  <td class="nowrap"><a href="{{ row.href }}">{{ row.id }}</a></td>
  <td><a class="row-title-link" href="{{ row.href }}">{{ row.title }}</a></td>
  <td>{{ row.area }}</td>
  <td><span class="badge {{ row.status }}">{{ row.status|label }}</span></td>
  <td class="credence-cell">
    <span class="credence-val">{{ row.credence }}</span>
    {% if row.credence_pct is not none %}<div class="mini-bar" aria-hidden="true"><span style="width:{{ row.credence_pct }}%"></span></div>{% endif %}
  </td>
  <td>{{ row.risk|label }}</td>
</tr>{% endfor %}
</tbody></table></div>
{% endif %}

<p class="json-foot"><a href="{{ index_url }}">Download JSON index ({{ index_url }})</a></p>
</div>
{% if kind == 'finding' and findings and findings.uncarded %}<section id="not-yet-carded" class="uncarded-section"><h2>{{ findings.uncarded.title }}</h2>{{ findings.uncarded.body|safe }}</section>{% endif %}
{% endblock %}
