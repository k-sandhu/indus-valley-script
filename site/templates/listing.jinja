{% extends "base.jinja" %}
{% block content %}
{% if kind == 'finding' and findings %}
{{ findings.intro|safe }}
<nav class="theme-nav" aria-label="Finding themes"><ul>{% for theme in findings.themes %}<li><a href="#{{ theme.anchor }}">{{ theme.title }}</a></li>{% endfor %}{% if findings.uncarded %}<li><a href="#not-yet-carded">Results not yet carded</a></li>{% endif %}</ul></nav>
{% elif kind == 'attempt' %}<p>Attempts are ordered by record date or package date, newest first. Attempts with no date appear last. Read the <a href="../timeline/index.html">timeline</a> for the research narrative.</p><nav class="date-nav" aria-label="Registry dates"><ul>{% for group in attempt_groups %}<li><a href="#date-{{ group.date or 'undated' }}">{{ group.title }}</a></li>{% endfor %}</ul></nav>{% endif %}
<div class="listing" data-index="{{ index_url }}">
<form class="filters" role="search">
  <label>Search <input type="search" name="search" autocomplete="off"></label>
  {% for field, values in filters.items() %}<label>{{ field|label }} <select name="{{ field }}"><option value="">All</option>{% for value in values %}<option value="{{ value }}">{{ value|label }}</option>{% endfor %}</select></label>{% endfor %}
  <button type="reset">Reset</button>
</form>
<p class="filter-count" role="status" aria-live="polite">{{ rows|length }} {{ 'questions' if kind == 'question' else 'attempts' if kind == 'attempt' else 'cards' }}</p>
{% if kind == 'finding' %}
{% if findings %}
{% for theme in findings.themes %}<section class="finding-theme" data-group aria-labelledby="{{ theme.anchor }}"><h2 id="{{ theme.anchor }}">{{ theme.title }}</h2>{{ theme.intro|safe }}<ul class="cards">{% for row in theme.rows %}<li data-id="{{ row.id }}"><h3><a href="{{ row.url }}">{{ row.id }}: {{ row.title }}</a></h3><span class="badge {{ row.status }}">{{ row.status|label }}</span>{% if row.result_html %}{{ row.result_html|safe }}{% else %}<p>{{ row.claim }}</p>{% endif %}</li>{% endfor %}</ul></section>{% endfor %}
{% else %}
{% for area, group in rows|groupby('area') %}<section data-group><h2>{{ area|capitalize }}</h2><ul class="cards">{% for row in group %}<li data-id="{{ row.id }}"><a href="{{ row.url }}">{{ row.id }}: {{ row.title }}</a> <span class="badge {{ row.status }}">{{ row.status|label }}</span></li>{% endfor %}</ul></section>{% endfor %}
{% endif %}
{% elif kind == 'question' %}
<div class="question-board">
{% for row in rows %}<article class="question" data-id="{{ row.id }}"><h2><a href="{{ row.url }}">{{ row.id }}: {{ row.title }}</a></h2><p>{{ row.claim }}</p><p><span class="badge {{ row.status }}">{{ row.status|label }}</span> · {{ row.area }} · {{ row.kind|label }} · Priority {{ row.priority }}</p><dl><dt>Claimed by</dt><dd>{{ row.claimed_by or 'Unclaimed' }}</dd><dt>Claim expires</dt><dd>{{ row.claim_expires or '—' }}</dd><dt>Data access</dt><dd>{{ row.data_access|label }}</dd><dt>Difficulty</dt><dd>{{ row.difficulty }}</dd></dl></article>{% endfor %}
</div>
{% elif kind == 'attempt' %}
{% for group in attempt_groups %}<section class="attempt-group" data-group aria-labelledby="date-{{ group.date or 'undated' }}"><h2 id="date-{{ group.date or 'undated' }}">{{ group.title }}</h2>
<div class="table-wrap"><table><thead><tr><th scope="col">Date</th><th scope="col">Attempt</th><th scope="col">Area</th><th scope="col">Status</th><th scope="col">Outcome</th></tr></thead><tbody>
{% for row in group.rows %}<tr data-id="{{ row.id }}"><td>{% if row.date %}<time datetime="{{ row.date }}">{{ row.date }}</time>{% else %}Undated{% endif %}</td><td><a href="{{ row.url }}">{{ row.id }}</a><p>{{ row.theme or row.title }}</p><p>{{ row.question }}</p></td><td>{{ row.area }}</td><td><span class="badge {{ row.status }}">{{ row.status|label }}</span></td><td>{{ row.outcome }}</td></tr>{% endfor %}
</tbody></table></div></section>{% endfor %}
{% else %}
<div class="table-wrap"><table><thead><tr><th scope="col">ID</th><th scope="col">{{ 'Claim' if kind == 'conjecture' else 'Question' }}</th><th scope="col">Area</th><th scope="col">Status</th>{% if kind == 'conjecture' %}<th scope="col">Credence</th><th scope="col">Risk</th>{% else %}<th scope="col">Outcome</th>{% endif %}</tr></thead><tbody>
{% for row in rows %}<tr data-id="{{ row.id }}"><td><a href="{{ row.url }}">{{ row.id }}</a></td><td>{{ row.title if kind == 'conjecture' else row.question }}</td><td>{{ row.area }}</td><td><span class="badge {{ row.status }}">{{ row.status|label }}</span></td>{% if kind == 'conjecture' %}<td>{{ row.credence }}</td><td>{{ row.risk|label }}</td>{% else %}<td>{{ row.outcome }}</td>{% endif %}</tr>{% endfor %}
</tbody></table></div>
{% endif %}
<p><a href="{{ index_url }}">JSON index</a></p>
</div>
{% if kind == 'finding' and findings and findings.uncarded %}<section id="not-yet-carded"><h2>{{ findings.uncarded.title }}</h2>{{ findings.uncarded.body|safe }}</section>{% endif %}
{% endblock %}
