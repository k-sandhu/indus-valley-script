<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page == 'index.html' %}Indus civilisation and script research{% else %}{{ title }} · Indus Research{% endif %}</title>
  <meta name="description" content="{{ meta_description }}">
  {% if canonical_url %}<link rel="canonical" href="{{ canonical_url }}">{% endif %}
  {% if favicon %}<link rel="icon" type="image/svg+xml" href="{{ favicon }}">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Indus civilisation and script research">
  <meta property="og:title" content="{% if page == 'index.html' %}Indus civilisation and script research{% else %}{{ title }} · Indus Research{% endif %}">
  <meta property="og:description" content="{{ meta_description }}">
  {% if canonical_url %}<meta property="og:url" content="{{ canonical_url }}">{% endif %}
  {% if social_image %}<meta property="og:image" content="{{ social_image }}">{% endif %}
  <meta name="twitter:card" content="{% if social_image %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{% if page == 'index.html' %}Indus civilisation and script research{% else %}{{ title }} · Indus Research{% endif %}">
  <meta name="twitter:description" content="{{ meta_description }}">
  {% if social_image %}<meta name="twitter:image" content="{{ social_image }}">{% endif %}
  <link rel="stylesheet" href="{{ css }}">
  <script src="{{ js }}" defer></script>
</head>
<body class="{% block body_class %}{% endblock %}">
<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="{{ home }}">
      <svg class="brand-mark" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="5" fill="#0f3134"/>
        <path d="M6 23V8h20v15H6m6.5 0V8m7 0v15M6 15.5h20" fill="none" stroke="#f6f5ee" stroke-width="1.5" stroke-linecap="square"/>
        <path d="M5 26.5h22" stroke="#d99852" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <span class="brand-text">
        <span class="brand-name">Indus Research</span>
        <span class="brand-sub">Civilisation &amp; script knowledge base</span>
      </span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <ul class="nav-list">
      {% for item in nav_groups %}<li class="nav-item{% if item.active %} current-section{% endif %}{% if item.children %} has-menu{% endif %}">
        {% if item.children %}<details class="nav-menu">
          <summary>{{ item.label }}{% if item.active %}<span class="sr-only"> (current section)</span>{% endif %}<span class="chev" aria-hidden="true">▾</span></summary>
          <ul class="nav-dropdown">{% for child in item.children %}<li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% elif child.active %} aria-current="location"{% endif %}>{{ child.label }}</a></li>{% endfor %}</ul>
        </details>{% else %}<a href="{{ item.url }}"{% if item.current %} aria-current="page"{% elif item.active %} aria-current="location"{% endif %}>{{ item.label }}</a>{% endif %}
      </li>{% endfor %}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="icon-link" href="{{ search_url }}"{% if page == 'search/index.html' %} aria-current="page"{% endif %} title="Search the knowledge base (press /)" aria-label="Search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="icon-label">Search</span>
      </a>
      <a class="repo-link" href="{{ repo }}">GitHub</a>
    </div>
  </div>
</header>
{% block hero %}{% endblock %}
<main id="content" class="{% block main_class %}page-main{% endblock %}">
  {% block page_header %}
  {% if breadcrumbs %}
  <nav class="breadcrumbs" aria-label="Breadcrumb"><ol>
    {% for crumb in breadcrumbs %}<li>{% if crumb.url %}<a href="{{ crumb.url }}">{{ crumb.label }}</a>{% else %}<span aria-current="page">{{ crumb.label }}</span>{% endif %}</li>{% endfor %}
  </ol></nav>
  {% endif %}
  <div class="page-head">
    <h1>{{ title }}</h1>
    {% if reading_time %}<p class="page-meta">{{ reading_time }} min read</p>{% endif %}
  </div>
  {% if worktree %}<p class="preview-banner">Worktree preview · source links remain pinned to HEAD ({{ commit[:12] }})</p>{% endif %}
  {% endblock %}
  {% block content %}{{ body|safe }}{% endblock %}
</main>
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-title">Indus civilisation and script research</p>
        <p class="footer-note">Open, source-linked knowledge base built by AI agents and human reviewers. The script remains undeciphered; every tested claim and failed run stays on record.</p>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Explore</p>
        <ul>
          <li><a href="{{ explore_url }}">Interactive tools</a></li>
          <li><a href="{{ search_url }}">Search knowledge base</a></li>
          <li><a href="{{ agents_url }}">Agent coordination hub</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-heading">For agents</p>
        <ul>
          <li><a href="{{ llms_url }}">llms.txt</a></li>
          <li><a href="{{ llms_full_url }}">llms-full.txt (full digest)</a></li>
          <li><a href="{{ repo }}">GitHub repository</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span><a href="{{ source_url }}">Source on GitHub</a> · Commit <code>{{ commit[:12] }}</code> ({{ commit_day }})</span>
      <span>Code: Unlicense · Project prose and cards: CC0 1.0 · Helsinki 1979 derivatives: CC BY 4.0</span>
    </div>
  </div>
</footer>
</body>
</html>
