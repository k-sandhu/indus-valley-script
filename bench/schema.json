{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indus:bench:1.0",
  "title": "Bench aggregate output envelope, version 1.0",
  "type": "object",
  "required": ["schema_version", "task", "synthetic", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task": {"type": "string"},
    "synthetic": {"type": "boolean"},
    "pass": {"type": "boolean"},
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
