!**/LICENSE.txt
# Downloaded papers, extracted text and full bibliographic source witnesses.
/research/literature/sources/**
/research/literature/primary/**
/research/literature/nonlinguistic_controls/*.jsonl
# Detailed predictions can reconstruct unresolved-rights input sequences.
*slot_audit.jsonl
/results/**/*predictions.jsonl
/results/**/predictions*.jsonl
# Large per-trial numerical tensors are local; summaries and seeds are retained.
*.npy
*.npz
*.pkl
*.pickle
*.parquet
# We deliberately do not maintain CI/CD configuration in this knowledge repo.
/.github/workflows/
*.import-part
*.log
/.venv/
