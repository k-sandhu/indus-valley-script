# Local acquired corpora are preserved in the project, not redistributed in Git.
/data/**
!/data/README.md
/.vendor/
/tmp/
/.playwright-cli/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
Thumbs.db
.env
.env.*
*.pem
*.key
# Third-party downloads, OCR and image witnesses need source-specific review.
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.tif
*.tiff
*.zip
*.gz
*.tar
*.xml
*.html
*.txt
# Our report, chart resource, package metadata and text documentation.
!/output/pdf/indus_script_research_report.pdf
!/output/chart_atlas/index.html
!/output/chart_atlas/**/*.png
# Original model diagrams, reviewed as our own generated figures.
!/experiments/2026-10-02-six-hour/stamp-geometry/illustrations/*.png
# Our reviewed calibration figure, generated from preserved numeric endpoints.
!/experiments/2026-10-02-six-hour/null-calibration/plots/main/*.png
!/experiments/2026-10-02-six-hour/null-calibration/plots/main/*.pdf
# Our reviewed mapping-stress figure and its numeric source are project work.
!/experiments/2026-10-02-six-hour/overlapping-forms/additional-v1/*.png
# Frozen generated mixture output is kept locally; lossless chunks carry it in Git.
/experiments/2026-10-02-six-hour/latent-forms/main-v1/results.json
!/experiments/2026-10-02-six-hour/latent-forms/git-package/main-results-v1/*.gz
!requirements.txt
!**/LICENSE.txt
# Downloaded papers, extracted text and full bibliographic source witnesses.
/research/literature/sources/**
/research/literature/primary/**
/research/literature/nonlinguistic_controls/*.jsonl
# Detailed predictions can reconstruct unresolved-rights input sequences.
*slot_audit.jsonl
/results/**/*predictions.jsonl
/results/**/predictions*.jsonl
/experiments/2026-10-02-six-hour/markov-baseline/**/*.jsonl
/experiments/2026-10-02-six-hour/markov-ablation/**/*.jsonl
# Large per-trial numerical tensors are local; summaries and seeds are retained.
*.npy
*.npz
*.pkl
*.pickle
*.parquet
# We deliberately do not maintain CI/CD configuration in this knowledge repo.
/.github/workflows/
*.import-part
*.log
/.venv/
# Our learning-curve figure and plotting requirements for the October 6 restoration comparison.
!/experiments/2026-10-06-modern-restoration/figures/*.png
!/experiments/2026-10-06-modern-restoration/plot-requirements.txt
# Provisional quarantined 1979 transcription outputs exceed Git limits; backed up to the private Hugging Face dataset.
/experiments/2026-10-07-helsinki1979-digitization/runs/*/occurrences.jsonl
/experiments/2026-10-07-helsinki1979-digitization/integration/*/ledger-import.jsonl
# CC BY 4.0-derived evaluation crops, chart sheets and inputs of the 1979 Helsinki digitization (package M), tracked for clean-clone replay.
!/experiments/2026-10-07-helsinki1979-digitization/blind/*.png
!/experiments/2026-10-07-helsinki1979-digitization/blind/chart_sheets/*.png
!/experiments/2026-10-07-helsinki1979-digitization/repair/*/blind/*.png
!/experiments/2026-10-07-helsinki1979-digitization/repair/*/blind/*/*.png
!/experiments/2026-10-07-helsinki1979-digitization/figures/*.png
!/experiments/2026-10-07-helsinki1979-digitization/*.txt
!/experiments/2026-10-07-helsinki1979-digitization/development/digits.npz
# Regenerable layout frames of the repaired 1979 pipeline exceed sensible Git sizes; backed up to the private Hugging Face dataset.
/experiments/2026-10-07-helsinki1979-digitization/repair/*/frame.json
